# Copy this file to .env and edit only .env for the server deployment.

# API and model
# API 访问密钥；留空表示不启用鉴权，设置后客户端必须使用完全相同的密钥。
CELLPOSE_API_KEY=
# Cellpose 模型名称；改成服务器本地已有或 Cellpose 支持的模型名。
CELLPOSE_MODEL=cpsam_v2
# 推理设备；auto 自动选择，cpu 强制用 CPU，cuda 强制用 NVIDIA GPU。
CELLPOSE_DEVICE=auto
# 单个上传文件允许的最大体积，单位 MB；图片较大时可适当调高。
CELLPOSE_MAX_UPLOAD_MB=256
# 容器内的模型目录；只有同时修改 compose 的模型目录挂载时才需要改。
CELLPOSE_LOCAL_MODELS_PATH=/models

# Inference defaults
# 细胞概率阈值；调低通常会检出更多区域，调高会减少低置信度区域。
CELLPOSE_CELLPROB_THRESHOLD=0.0
# 流场误差阈值；调高会更宽松地保留对象，调低会更严格地过滤对象。
CELLPOSE_FLOW_THRESHOLD=0.4
# 最小实例面积，单位像素；小于该值的分割对象会被删除。
CELLPOSE_MIN_SIZE=15
# 预估细胞直径，单位像素；留空表示让模型自动处理，已知目标尺寸时可填写数值。
CELLPOSE_DIAMETER=
# 是否在推理前归一化图像强度；true 开启，false 保留原始强度范围。
CELLPOSE_NORMALIZE=true
# 是否反转图像亮暗；亮背景、暗目标的图像可尝试设为 true。
CELLPOSE_INVERT=false

# Docker Compose and container runtime
# Docker 镜像名称和标签；重新命名镜像或切换版本时修改。
CELLPOSE_IMAGE=local/cellpose-server:4.2.1.1
# 容器退出后的重启策略；unless-stopped 表示除非手动停止，否则自动重启。
CELLPOSE_RESTART_POLICY=unless-stopped
# 宿主机监听地址；127.0.0.1 仅本机可访问，0.0.0.0 可供局域网访问。
CELLPOSE_BIND_HOST=127.0.0.1
# 宿主机暴露的服务端口；端口冲突或需要换访问端口时修改。
CELLPOSE_BIND_PORT=8000
# 容器内服务监听地址；Docker 部署通常保持 0.0.0.0。
CELLPOSE_CONTAINER_HOST=0.0.0.0
# 容器内服务端口；修改时需同步调整健康检查地址和端口映射。
CELLPOSE_CONTAINER_PORT=8000
# Uvicorn 工作进程数；GPU 推理通常保持 1，增加会额外占用显存和内存。
CELLPOSE_WORKERS=1
# 容器共享内存大小；处理大图或出现共享内存不足时可调高。
CELLPOSE_SHM_SIZE=8gb
# 分配给容器的 GPU 数量；无 GPU 部署时需要结合 compose 配置调整。
CELLPOSE_GPU_COUNT=1
# 容器内部健康检查地址；服务路径或容器端口变化时同步修改。
CELLPOSE_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz
# 健康检查脚本单次 HTTP 请求的超时秒数。
CELLPOSE_HEALTHCHECK_TIMEOUT_SECONDS=3
# Docker 两次健康检查之间的间隔时间，例如 30s 或 1m。
CELLPOSE_HEALTHCHECK_INTERVAL=30s
# Docker 允许单次健康检查命令运行的最长时间。
CELLPOSE_HEALTHCHECK_TIMEOUT=5s
# 容器启动后的健康检查宽限期；首次加载大模型较慢时可调高。
CELLPOSE_HEALTHCHECK_START_PERIOD=10m
# 连续健康检查失败多少次后将容器标记为 unhealthy。
CELLPOSE_HEALTHCHECK_RETRIES=3
