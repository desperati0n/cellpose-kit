# English template. For Chinese comments, see .env.example.zh-CN.
# Copy this file to .env and edit only .env for the server deployment.

# API and model
# API access key. Leave empty to disable authentication; when set, the client must use the exact same key.
CELLPOSE_API_KEY=
# Cellpose model name. Set this to a model available locally or supported by Cellpose.
CELLPOSE_MODEL=cpsam_v2
# Inference device: auto selects automatically, cpu forces CPU, and cuda forces an NVIDIA GPU.
CELLPOSE_DEVICE=auto
# Maximum upload size per file in MB.
CELLPOSE_MAX_UPLOAD_MB=256
# Model directory inside the container. Change only when updating the matching Compose volume mount.
CELLPOSE_LOCAL_MODELS_PATH=/models

# Inference defaults
# Cell-probability threshold. Lower values usually retain more regions; higher values remove low-confidence regions.
CELLPOSE_CELLPROB_THRESHOLD=0.0
# Flow-error threshold. Higher values are more permissive; lower values filter objects more strictly.
CELLPOSE_FLOW_THRESHOLD=0.4
# Minimum instance area in pixels. Smaller objects are removed.
CELLPOSE_MIN_SIZE=15
# Estimated cell diameter in pixels. Leave empty for automatic/default model handling.
CELLPOSE_DIAMETER=
# Normalize image intensity before inference: true or false.
CELLPOSE_NORMALIZE=true
# Invert bright/dark polarity. Try true for bright-background, dark-object images.
CELLPOSE_INVERT=false

# Docker Compose and container runtime
# Docker image name and tag.
CELLPOSE_IMAGE=local/cellpose-server:4.2.1.1
# Container restart policy. unless-stopped restarts unless the container was stopped manually.
CELLPOSE_RESTART_POLICY=unless-stopped
# Host bind address. 127.0.0.1 is local-only; 0.0.0.0 allows network access subject to firewall/security controls.
CELLPOSE_BIND_HOST=127.0.0.1
# Host port exposed by Docker.
CELLPOSE_BIND_PORT=8000
# Service bind address inside the container; normally keep 0.0.0.0.
CELLPOSE_CONTAINER_HOST=0.0.0.0
# Service port inside the container. Keep port mapping and health-check URLs in sync if changed.
CELLPOSE_CONTAINER_PORT=8000
# Uvicorn worker count. Keep 1 for typical GPU inference to avoid duplicate model memory use.
CELLPOSE_WORKERS=1
# Container shared-memory size.
CELLPOSE_SHM_SIZE=8gb
# Number of GPUs reserved for the container.
CELLPOSE_GPU_COUNT=1
# Internal health-check URL.
CELLPOSE_HEALTHCHECK_URL=http://127.0.0.1:8000/healthz
# Timeout in seconds for the health-check script HTTP request.
CELLPOSE_HEALTHCHECK_TIMEOUT_SECONDS=3
# Interval between Docker health checks.
CELLPOSE_HEALTHCHECK_INTERVAL=30s
# Maximum duration of one Docker health-check command.
CELLPOSE_HEALTHCHECK_TIMEOUT=5s
# Grace period after container startup; increase when first model loading is slow.
CELLPOSE_HEALTHCHECK_START_PERIOD=10m
# Consecutive failed checks before Docker marks the container unhealthy.
CELLPOSE_HEALTHCHECK_RETRIES=3
