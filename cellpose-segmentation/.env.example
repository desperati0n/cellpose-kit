# English template. For Chinese comments, see .env.example.zh-CN.
# Copy this file to .env and edit only .env for this Skill installation.

# Client connection
# Base URL of the Cellpose HTTP service. Use the server IP/domain and port for a remote deployment.
CELLPOSE_SERVICE_URL=http://127.0.0.1:8000
# API access key. Leave empty when server authentication is disabled; otherwise it must match the server value.
CELLPOSE_API_KEY=
# Maximum number of seconds the client waits for one end-to-end segmentation request.
CELLPOSE_TIMEOUT_SECONDS=600

# Shared inference defaults
# Cell-probability threshold. Lower values usually retain more regions; higher values remove low-confidence regions.
CELLPOSE_CELLPROB_THRESHOLD=0.0
# Flow-error threshold. Higher values are more permissive; lower values filter objects more strictly.
CELLPOSE_FLOW_THRESHOLD=0.4
# Minimum instance area in pixels. Smaller objects are removed.
CELLPOSE_MIN_SIZE=15
# Estimated cell diameter in pixels. Leave empty for automatic/default model handling.
CELLPOSE_DIAMETER=
# Normalize image intensity before inference: true or false.
CELLPOSE_NORMALIZE=true
# Invert bright/dark polarity: true or false.
CELLPOSE_INVERT=false
