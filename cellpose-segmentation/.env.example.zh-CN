# Copy this file to .env and edit only .env for this Skill installation.

# Client connection
# Cellpose HTTP 服务地址；服务在其他机器时改成该服务器的 IP 或域名与端口。
CELLPOSE_SERVICE_URL=http://127.0.0.1:8000
# API 访问密钥；服务端未设置密钥时留空，启用鉴权时必须与服务端一致。
CELLPOSE_API_KEY=
# 客户端等待一次分割请求完成的最长秒数；大图或首次加载模型较慢时可调高。
CELLPOSE_TIMEOUT_SECONDS=600

# Shared inference defaults
# 细胞概率阈值；调低通常会检出更多区域，调高会减少低置信度区域。
CELLPOSE_CELLPROB_THRESHOLD=0.0
# 流场误差阈值；调高会更宽松地保留对象，调低会更严格地过滤对象。
CELLPOSE_FLOW_THRESHOLD=0.4
# 最小实例面积，单位像素；小于该值的分割对象会被删除。
CELLPOSE_MIN_SIZE=15
# 预估细胞直径，单位像素；留空表示让模型自动处理，已知目标尺寸时可填写数值。
CELLPOSE_DIAMETER=
# 是否在推理前归一化图像强度；true 开启，false 保留原始强度范围。
CELLPOSE_NORMALIZE=true
# 是否反转图像亮暗；亮背景、暗目标的图像可尝试设为 true。
CELLPOSE_INVERT=false
